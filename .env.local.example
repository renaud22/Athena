# .env.local.example — variables d'environnement du CRM Solutix.
# Copier vers .env.local et remplir avec les vraies valeurs.
# NE JAMAIS commiter .env.local ni aucun .env* (déjà à mettre dans .gitignore au scaffolding).
#
# CONTRAT DE NOMMAGE (faisant foi pour tout le code) — aligné sur le système
# de clés Supabase actuel (publishable / secret, et non plus anon / service_role).

# --- Base de données (Prisma 7 + Supabase) ---
# DATABASE_URL : pooler Supavisor (transaction), port 6543, suffixe obligatoire ?pgbouncer=true.
#                Utilisé à l'exécution par le client Prisma (driver adapter @prisma/adapter-pg).
DATABASE_URL=

# DIRECT_URL : connexion directe, port 5432. Utilisée par le CLI Prisma pour les migrations.
DIRECT_URL=

# --- Supabase (Auth + API) ---
# URL du projet : https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé PUBLISHABLE (sb_publishable_...) = ex-"anon". Exposable côté client. Le RLS s'applique.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé SECRET (sb_secret_...) = ex-"service_role". SERVEUR UNIQUEMENT, jamais exposée au client.
# Bypasse le RLS — réservée aux usages serveur / agents off-app.
SUPABASE_SECRET_KEY=
